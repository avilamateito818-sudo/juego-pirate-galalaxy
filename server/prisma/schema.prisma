generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pilot {
  id           String            @id @default(cuid())
  callsign     String            @unique
  email        String            @unique
  passwordHash String
  cryonite     Int               @default(0)
  energy       Int               @default(100)
  activePlanet String            @default("vega_kalabesh")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  ships        Ship[]
  blueprints   BlueprintUnlock[]

  @@index([activePlanet])
}

model Ship {
  id          String   @id @default(cuid())
  pilotId     String
  shipModelId String
  isActive    Boolean  @default(false)
  hullMax     Int      @default(100)
  shieldMax   Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pilot       Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
}

model BlueprintUnlock {
  id          String   @id @default(cuid())
  pilotId     String
  blueprintId String
  collected   Int      @default(0)
  required    Int      @default(1)
  unlocked    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  pilot       Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, blueprintId])
  @@index([pilotId])
}
