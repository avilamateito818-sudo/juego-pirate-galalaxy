# Puertos dedicados exclusivos para StarCorsair (rango 49xxx para no chocar con otros proyectos)
CLIENT_PORT=49100
CLIENT_DEV_PORT=49173
SERVER_PORT=49267
POSTGRES_PORT=49543

# PostgreSQL (Docker Compose & Prisma)
POSTGRES_USER=starcorsair
POSTGRES_PASSWORD=starcorsair_dev_password
POSTGRES_DB=starcorsair
DATABASE_URL="postgresql://starcorsair:starcorsair_dev_password@127.0.0.1:49543/starcorsair?schema=public"

# Server (Node.js + Colyseus)
NODE_ENV=development
JWT_SECRET="replace-with-a-strong-random-secret-in-production"
CORS_ORIGIN="http://127.0.0.1:49173"

# Client (Vite / Docker)
VITE_SERVER_WS_URL="ws://127.0.0.1:49267"
VITE_SERVER_HTTP_URL="http://127.0.0.1:49267"
