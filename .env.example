# PostgreSQL (Docker Compose & Prisma)
POSTGRES_USER=starcorsair
POSTGRES_PASSWORD=starcorsair_dev_password
POSTGRES_DB=starcorsair
POSTGRES_PORT=5432
DATABASE_URL="postgresql://starcorsair:starcorsair_dev_password@localhost:5432/starcorsair?schema=public"

# Server (Node.js + Colyseus)
SERVER_PORT=2567
NODE_ENV=development
JWT_SECRET="replace-with-a-strong-random-secret-in-production"
CORS_ORIGIN="http://localhost:5173"

# Client (Vite)
VITE_SERVER_WS_URL="ws://localhost:2567"
VITE_SERVER_HTTP_URL="http://localhost:2567"
